# Homeward environment variables — every var the app (and its local ops scripts) reads.
# Every key is optional and degrades independently — see CLAUDE.md and .env.local.example
# for exactly what each key unlocks and what happens when it's missing.
# Copy this file to .env.local and fill in whichever keys you have. Never commit real values.

# --- LLM providers (multi-provider failover chain: Groq -> OpenAI -> Gemini -> Grok -> Hunyuan) ---
# Chain order and fallback behavior are implemented in lib/llm.ts.
# With none of these set, lib/llm.ts falls back to a local deterministic heuristic
# (templated plan text, keyword-based comparisons) so the app still runs end to end.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
HUNYUAN_API_KEY=

# Optional: override default model per provider
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# XAI_MODEL=grok-3-mini
# HUNYUAN_MODEL=hunyuan-turbos-latest

# GEMINI_API_KEY is also used directly (not just as a failover tier) for multimodal
# vision calls in lib/parser.ts (discharge photo parsing) and lib/woundVision.ts
# (wound photo description). Without it, photo uploads fall back to manual text entry.

# --- Retrieval ---
# lib/exa.ts is a domain-restricted FALLBACK only, queried only when lib/rag.ts's
# curated knowledge base has no relevant match. Without this key, retrieval is
# limited to the curated KB (which still works with zero keys via keyword fallback).
EXA_API_KEY=

# --- Storage / backend (Supabase) ---
# Without Supabase configured, planStore.ts falls back to localStorage +
# BroadcastChannel for a zero-setup single-device demo (patient/caregiver views
# in separate browser tabs on the same machine instead of separate devices).
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time — that's expected,
# the anon key is meant to be public (Supabase RLS is what should gate access; see
# supabase/schema.sql's comments — this project's default RLS is left open for the demo).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose this one to the client. Only used by local ops scripts
# (npm run seed:kb, npm run seed:demo), never by any deployed app/api/* route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Silence detection (app/api/silence-check) ---
# Shared secret the n8n silence-detection workflow must send as the X-Silence-Check-Key
# header. Required — with this unset, app/api/silence-check refuses every request (fails
# closed) rather than running unauthenticated. Generate any long random string, e.g.
# `openssl rand -hex 32`.
SILENCE_CHECK_SECRET=

# Base URL of this deployment (no trailing slash), e.g. https://homeward.example.com or
# http://localhost:3000 for local testing. Used only to build each silent patient's
# caregiverPortalUrl (/caregiver?code=...) in the silence-check response, for the n8n email
# node's call-to-action link. Without it, caregiverPortalUrl is null — nothing else breaks.
APP_URL=

# --- Local demo seed script only (scripts/seed-demo.ts, `npm run seed:demo`) ---
# Never read by the deployed app itself. Caregiver email attached to the "DEMO02" gone-quiet
# demo patient, so /api/silence-check has somewhere to point a reminder. Without it, the
# script skips seeding DEMO02 (still seeds DEMO01) and says so in its output.
DEMO_CAREGIVER_EMAIL=
